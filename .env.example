# Use a SANDBOX key while developing. Prefer a restricted key (rk_...) over a secret key (sk_...).
# Restricted key permissions needed (write unless noted):
#   Checkout Sessions, Customers, Invoices, Invoice Items,
#   Tax Calculations, Tax Settings (read), Tax Registrations (read), Tax Codes (read)
STRIPE_SECRET_KEY=rk_test_...

# From `stripe listen` (local) or Dashboard > Developers > Webhooks (deployed endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL of the site; used for Checkout success/cancel redirects
SITE_URL=http://localhost:3000

# Protects POST /api/invoices. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Optional: product tax code for consulting services. Pick it with
#   npm run tax:check -- --codes consulting
# and confirm with your tax advisor. Left unset, Stripe uses your account preset.
STRIPE_TAX_CODE_SERVICES=

PORT=3000
